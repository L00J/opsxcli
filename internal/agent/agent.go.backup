package agent

import (
	"context"
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/fatih/color"
	"opsxcli/internal/llm"
	"opsxcli/internal/tools"
)

const (
	// 系统提示词 - 优化版:强调行动优先
	systemPrompt = `你是专业的运维AI助手。

【核心原则 - 行动优先于思考】
- 立即执行,不要过度规划
- 先动手做,遇到问题再调整
- 一步一步来,每次执行一个关键操作
- 看到结果后再决定下一步

【可用工具】
文件: cat, grep, ls, head, tail, tree, file_read, file_write, file_edit
目录: mkdir, chmod, chown, touch
系统: ps, top, free, df, du, uname, bash(执行任意命令)
网络: ping, ss, netstat, ifconfig, wget, curl, ssh
K8s: kubectl_get, kubectl_describe, kubectl_logs, kubectl_delete
安装: install(自动识别yum/apt等包管理器)
开发: git_status, git_diff, code_search
危险操作: rm, dd (需要用户确认)

【执行策略】
1. 复杂任务分解:
   - 部署任务 → 检查环境 → 安装依赖 → 下载软件 → 配置 → 启动 → 验证
   - 每完成一步,观察结果,再执行下一步

2. 错误恢复:
   - 命令失败了?先看错误信息,用bash工具尝试其他方法
   - 下载失败?换个镜像源或URL
   - 依赖缺失?立即用install工具安装
   - 不要因为一次失败就放弃,尝试3种不同方法

3. 验证闭环:
   - 安装后检查版本
   - 启动后检查进程
   - 部署后测试功能
   - 确保任务真正完成

【禁止行为】
❌ 长篇大论规划而不执行
❌ 重复调用相同失败的命令
❌ 遇到错误就停止
❌ 完成任务后不验证

【示例:部署软件】
✅ 第1步: uname -a (了解系统)
✅ 第2步: install java (安装依赖,失败了再试其他方法)
✅ 第3步: bash "java -version" (验证安装)
✅ 第4步: wget下载软件 (失败就换URL)
✅ 第5步: 解压配置
✅ 第6步: 启动服务
✅ 第7步: 检查进程和端口
✅ 第8步: 总结结果

记住:少说多做,边做边调整,直到任务真正完成!`

	// 最大迭代次数 - 增加到50以支持复杂任务
	maxIterations = 50

	// 工具调用超时
	toolTimeout = 30 * time.Second

	// 输出压缩阈值
	maxOutputLength = 300
	// 历史消息保留数量（系统消息 + 用户查询 + 最近N轮对话）- 增加到12轮
	maxHistoryRounds = 12

	// 重复工具调用检测阈值 - 相同工具调用超过此次数视为异常
	maxSameToolCalls = 3
)

// Agent AI Agent
type Agent struct {
	llmClient        llm.Client
	toolRegistry     *tools.ToolRegistry
	safetyController *SafetyController
	maxIterations    int
	startTime        time.Time
	totalTokens      int
}

// NewAgent 创建Agent
func NewAgent(
	llmClient llm.Client,
	toolRegistry *tools.ToolRegistry,
	safetyController *SafetyController,
) *Agent {
	return &Agent{
		llmClient:        llmClient,
		toolRegistry:     toolRegistry,
		safetyController: safetyController,
		maxIterations:    maxIterations,
	}
}

// Run 运行Agent（ReAct循环）
func (a *Agent) Run(ctx context.Context, userQuery string) (string, error) {
	// 记录开始时间
	a.startTime = time.Now()
	a.totalTokens = 0

	// 初始化对话历史
	messages := []llm.Message{
		{
			Role:    "system",
			Content: systemPrompt,
		},
		{
			Role:    "user",
			Content: userQuery,
		},
	}

	// 获取可用工具
	llmTools := a.convertToolsToLLMFormat()

	// 工具调用历史（用于检测重复）
	toolCallHistory := make(map[string]int)

	// 显示初始状态
	fmt.Printf("\r%s Thinking…", color.New(color.FgCyan).Sprint("✻"))

	// ReAct循环
	for i := 0; i < a.maxIterations; i++ {
		// 裁剪历史消息，保留系统消息 + 用户查询 + 最近几轮对话
		trimmedMessages := a.trimMessages(messages)

		// 调用LLM
		resp, err := a.llmClient.Complete(ctx, &llm.CompletionRequest{
			Messages:    trimmedMessages,
			Tools:       llmTools,
			Temperature: 0.7,
			MaxTokens:   4096,
		})

		if err != nil {
			fmt.Print("\r\033[K") // 清除当前行
			return "", fmt.Errorf("LLM调用失败: %w", err)
		}

		// 添加assistant消息到历史
		messages = append(messages, resp.Message)

		// 更新 token 统计
		a.totalTokens += resp.Usage.TotalTokens

		// 如果没有工具调用，返回结果
		if len(resp.Message.ToolCalls) == 0 {
			fmt.Print("\r\033[K") // 清除当前行
			return resp.Message.Content, nil
		}

		// 更新进度显示
		elapsed := time.Since(a.startTime)
		progressMsg := fmt.Sprintf("\r%s Thinking… (%s · step %d/%d",
			color.New(color.FgCyan).Sprint("✻"),
			formatDuration(elapsed),
			i+1,
			a.maxIterations)

		if a.totalTokens > 0 {
			progressMsg += fmt.Sprintf(" · ↓ %s tokens", formatNumber(a.totalTokens))
		}
		progressMsg += ")"

		fmt.Print(progressMsg)

		// 处理工具调用
		toolMessages := make([]llm.Message, 0, len(resp.Message.ToolCalls))

		for _, toolCall := range resp.Message.ToolCalls {
			// 检测重复工具调用
			toolKey := fmt.Sprintf("%s:%s", toolCall.Function.Name, toolCall.Function.Arguments)
			toolCallHistory[toolKey]++

			// 如果相同工具调用次数过多，警告
			if toolCallHistory[toolKey] > maxSameToolCalls {
				fmt.Print("\r\033[K") // 清除当前行
				warnMsg := fmt.Sprintf("⚠️  Warning: Tool '%s' called %d times, possible loop",
					toolCall.Function.Name, toolCallHistory[toolKey])
				color.New(color.FgYellow).Println(warnMsg)
				fmt.Print(progressMsg) // 恢复进度显示
			}

			result := a.executeToolCall(ctx, toolCall, i == 0)
			// 压缩工具结果
			compressedResult := a.compressToolOutput(result)
			toolMessages = append(toolMessages, llm.Message{
				Role:       "tool",
				Content:    compressedResult,
				ToolCallID: toolCall.ID,
				Name:       toolCall.Function.Name,
			})
		}

		// 添加工具结果到历史
		messages = append(messages, toolMessages...)
	}

	fmt.Print("\r\033[K") // 清除当前行
	// 提供更详细的失败信息
	return "", fmt.Errorf("达到最大迭代次数(%d次)，Agent未能完成任务。可能原因：任务过于复杂或遇到循环调用", a.maxIterations)
}

// executeToolCall 执行工具调用
func (a *Agent) executeToolCall(ctx context.Context, toolCall llm.ToolCall, firstCall bool) string {
	// 只在第一次调用时显示工具详情
	if firstCall {
		fmt.Print("\r\033[K") // 清除进度行
		// 显示工具调用（简化风格）
		toolColor := color.New(color.FgMagenta)
		fmt.Printf("  %s %s\n", toolColor.Sprint("→"), toolColor.Sprint(toolCall.Function.Name))
	}

	// 获取工具
	tool, err := a.toolRegistry.Get(toolCall.Function.Name)
	if err != nil {
		errorColor := color.New(color.FgRed)
		fmt.Printf("  %s %s\n", color.HiBlackString("⎿"), errorColor.Sprintf("错误: %v", err))
		return fmt.Sprintf("错误: %v", err)
	}

	// 解析参数
	var args map[string]interface{}
	if err := json.Unmarshal([]byte(toolCall.Function.Arguments), &args); err != nil {
		return fmt.Sprintf("参数解析失败: %v", err)
	}

	// 安全检查
	approved, auditLog, err := a.safetyController.CheckToolExecution(tool, args)
	if err != nil {
		return fmt.Sprintf("安全检查失败: %v", err)
	}

	if !approved {
		return "用户拒绝执行此操作"
	}

	// 执行工具
	toolCtx, cancel := context.WithTimeout(ctx, toolTimeout)
	defer cancel()

	result, err := tool.Execute(toolCtx, args)
	if err != nil {
		errMsg := fmt.Sprintf("工具执行异常: %v", err)
		// 记录执行失败
		a.safetyController.MarkExecuted(auditLog, &tools.ToolResult{
			Success: false,
			Error:   errMsg,
		})
		return errMsg
	}

	// 记录执行结果
	a.safetyController.MarkExecuted(auditLog, result)

	if result.Success {
		return result.Output
	} else {
		return fmt.Sprintf("执行失败: %s\n输出: %s", result.Error, result.Output)
	}
}

// convertToolsToLLMFormat 转换工具为LLM格式
func (a *Agent) convertToolsToLLMFormat() []llm.Tool {
	toolsList := a.toolRegistry.List()
	llmTools := make([]llm.Tool, len(toolsList))

	for i, tool := range toolsList {
		llmTools[i] = llm.Tool{
			Type: "function",
			Function: llm.ToolFunction{
				Name:        tool.Name(),
				Description: tool.Description(),
				Parameters:  tool.Parameters(),
			},
		}
	}

	return llmTools
}

// compressToolOutput 压缩工具输出结果
func (a *Agent) compressToolOutput(output string) string {
	// 如果输出为空或很短，直接返回
	if len(output) <= maxOutputLength {
		return output
	}

	// 计算行数
	lines := strings.Split(output, "\n")
	lineCount := len(lines)

	// 如果输出很长，进行智能压缩
	if lineCount > 10 {
		// 保留前 5 行和后 3 行，中间用摘要替代
		summary := strings.Join(lines[:5], "\n")
		summary += fmt.Sprintf("\n... [省略 %d 行] ...\n", lineCount-8)
		summary += strings.Join(lines[lineCount-3:], "\n")
		return summary
	}

	// 如果是单行但很长，截断并标记
	if lineCount <= 3 {
		return output[:maxOutputLength] + fmt.Sprintf("... [截断，总长度: %d]", len(output))
	}

	// 中等长度，保留前几行
	keep := maxOutputLength / (len(lines[0]) + 1)
	if keep > lineCount {
		keep = lineCount
	}
	if keep < 3 {
		keep = 3
	}

	summary := strings.Join(lines[:keep], "\n")
	if keep < lineCount {
		summary += fmt.Sprintf("\n... [省略 %d 行]", lineCount-keep)
	}

	return summary
}

// trimMessages 裁剪消息历史，只保留最近的对话
func (a *Agent) trimMessages(messages []llm.Message) []llm.Message {
	// 如果消息数量不多，直接返回
	// 计算：system(1) + user(1) + 每轮对话(assistant + tool messages)
	// 保留最近 maxHistoryRounds 轮
	if len(messages) <= 2+maxHistoryRounds*2 {
		return messages
	}

	// 始终保留 system 和 user 的初始消息
	trimmed := make([]llm.Message, 0, 2+maxHistoryRounds*2)
	trimmed = append(trimmed, messages[0]) // system
	trimmed = append(trimmed, messages[1]) // user query

	// 计算要保留的消息起始位置
	// 从后往前保留最近的 N 轮对话
	keepFrom := len(messages) - maxHistoryRounds*2
	if keepFrom < 2 {
		keepFrom = 2
	}

	// 添加最近的对话
	trimmed = append(trimmed, messages[keepFrom:]...)

	return trimmed
}

// formatDuration 格式化时长
func formatDuration(d time.Duration) string {
	seconds := int(d.Seconds())
	if seconds < 60 {
		return fmt.Sprintf("%ds", seconds)
	}
	minutes := seconds / 60
	secs := seconds % 60
	return fmt.Sprintf("%dm %ds", minutes, secs)
}

// formatNumber 格式化数字（添加千位分隔符）
func formatNumber(n int) string {
	if n < 1000 {
		return fmt.Sprintf("%d", n)
	}
	if n < 1000000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%.1fM", float64(n)/1000000)
}
